# Copy this file to .env and fill in real values. Never commit .env itself -
# it's already in .gitignore. On Railway, set these in the project's
# Variables tab instead (see DEPLOY.md).

# --- Required ---
SUPABASE_URL=
SUPABASE_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ANTHROPIC_API_KEY=

# --- LLM (optional - defaults to Claude) ---
LLM_PROVIDER=
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_OUTPUT_TOKENS=
GROQ_API_KEY=
GROQ_MODEL=
HF_API_KEY=

# --- Supabase table names (optional - defaults shown in outreach_bot.py) ---
SUPABASE_COMPANY_TABLE=
SUPABASE_PERSON_TABLE=
SUPABASE_LEADS_TABLE=

# --- Google Calendar booking (optional - skip if using Calendly instead) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Calendly booking (optional - skip if using Google Calendar instead) ---
CALENDLY_LINK=
CALENDLY_API_TOKEN=
CALENDLY_LOOKAHEAD_DAYS=
CALENDLY_LOOKBACK_DAYS=

# --- Scan behaviour (optional) ---
BATCH_SIZE=
PERSON_BATCH_SIZE=
COMPOSE_BATCH_SIZE=
RUN_INTERVAL_MINUTES=
MAX_NEW_TRIES_PER_TABLE=
MAX_RESEARCH_BACKFILL_PER_RUN=
MAX_ROLE_BACKFILL_PER_RUN=
MISS_FALLBACK_N=
PREFETCH_SCRAPE_COUNT=
VERIFY_TOP_N=
SLOT_SEARCH_DAYS=
WORK_START_HOUR=
WORK_END_HOUR=
WORK_DAYS=
TIMEZONE=
EMAIL_LANGUAGE=
REVIEW_MODE=
SKIP_LIVENESS_CHECK=
LEARNING_ENABLED=
LEARNING_BATCH_SIZE=
ROLE_KEYWORD_ACCEPT_THRESHOLD=
ROLE_NEEDS_REVIEW_THRESHOLD=

# --- Optional integrations ---
CLEAROUT_API_KEY=
CLEAROUT_TIMEOUT_MS=
APOLLO_API_KEY=
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
COMPANY_SEARCH_PROVIDER=
COMPANY_DB_PATH=
ISRAEL_GOV_COMPANIES_RESOURCE_ID=
INFOBEL_API_KEY=
INFOBEL_BASE_URL=
REVENUEBASE_API_KEY=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
CHECKPOINT_DIR=
LEADS_FILE=

# --- File paths (optional - defaults shown in outreach_bot.py) ---
ICP_FILE=
LESSONS_FILE=
EMAIL_TEMPLATE_FILE=
PERSONA_TEMPLATES_FILE=
